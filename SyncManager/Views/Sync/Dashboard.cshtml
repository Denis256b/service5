@{
    ViewData["Title"] = "Дашборд";
}

<!-- Панель управления -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Управление демоном</h5>
                <div>
                    <button id="btnStart" class="btn btn-success">
                        ▶ Запустить
                    </button>
                    <button id="btnStop" class="btn btn-danger" disabled>
                        ■ Остановить
                    </button>
                    <button id="btnExecute" class="btn btn-primary">
                        ⟳ Выполнить разово
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="text-center">
                            <div id="statusIndicator" class="status-badge status-stopped">Остановлен</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-muted">Время работы</h6>
                        <p id="uptimeDisplay" class="display-6 mb-0">00:00:00</p>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-muted">Всего вставлено</h6>
                        <p id="insertedDisplay" class="display-6 text-success mb-0">0</p>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-muted">Всего обновлено</h6>
                        <p id="updatedDisplay" class="display-6 text-info mb-0">0</p>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-4">
                        <h6 class="text-muted">Всего скопировано</h6>
                        <p id="totalDisplay" class="display-6 mb-0">0</p>
                    </div>
                    <div class="col-md-4">
                        <h6 class="text-muted">Последняя синхронизация</h6>
                        <p id="lastSyncDisplay" class="display-6 mb-0">—</p>
                    </div>
                    <div class="col-md-4">
                        <h6 class="text-muted">Интервал / Батч</h6>
                        <p id="configDisplay" class="display-6 mb-0">—</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Сводка по отчётам -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Отчёты</h5>
                <a href="/reports" class="btn btn-sm btn-outline-primary">Открыть раздел →</a>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-6 col-md">
                        <h6 class="text-muted">В очереди</h6>
                        <p class="display-6 mb-0" id="reportPendingCount">0</p>
                    </div>
                    <div class="col-6 col-md">
                        <h6 class="text-muted">Выполняются</h6>
                        <p class="display-6 text-primary mb-0" id="reportProcessingCount">0</p>
                    </div>
                    <div class="col-6 col-md">
                        <h6 class="text-muted">Готово</h6>
                        <p class="display-6 text-success mb-0" id="reportDoneCount">0</p>
                    </div>
                    <div class="col-6 col-md">
                        <h6 class="text-muted">Ошибки</h6>
                        <p class="display-6 text-danger mb-0" id="reportErrorCount">0</p>
                    </div>
                    <div class="col-6 col-md">
                        <h6 class="text-muted">Отменено</h6>
                        <p class="display-6 text-dark mb-0" id="reportCancelledCount">0</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- График активности -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Активность по итерациям</h5>
            </div>
            <div class="card-body">
                <div style="height: 320px;">
                    <canvas id="activityChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Таблица истории -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">История синхронизаций</h5>
            </div>
        <div class="card-body">
            <table id="historyGrid" class="display" style="width:100%"></table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
</div>