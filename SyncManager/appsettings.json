{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Proxy": {
    "UserHeader": "X-Remote-User",
    "GroupHeader": "X-Remote-Group",
    "GroupSeparator": ";"
  },
  "Report": {
    "Providers": [
      { "Id": "sample", "Name": "Эталонный провайдер" },
      { "Id": "sample2", "Name": "Второй тестовый провайдер" }
    ]
  },
  "ConnectionStrings": {
    "SyncBus": "Host=localhost;Database=syncbus;Username=CHANGE_ME;Password=CHANGE_ME"
  }
}
